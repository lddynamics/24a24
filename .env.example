# Copier vers .env puis adapter. Ne JAMAIS committer .env.

# Rôle applicatif (soumis à la RLS)
DATABASE_URL=postgresql+psycopg://agent24_app:app_pw@localhost:5432/agent24
# Rôle propriétaire (migrations et scripts d'administration uniquement)
MIGRATIONS_DATABASE_URL=postgresql+psycopg://agent24_owner:owner_pw@localhost:5432/agent24

# Application Meta (une seule pour toute la plateforme, les pages des clients s'y connectent)
META_APP_SECRET=remplacer_par_le_secret_de_l_app_meta
MESSENGER_VERIFY_TOKEN=une_chaine_aleatoire_longue

# Clé Fernet pour chiffrer les jetons des canaux au repos :
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

LOG_LEVEL=INFO

# true : le worker tourne dans le processus web (Render gratuit). En local, laisser false et lancer « python -m app.worker ».
EMBEDDED_WORKER=false

# Worker / agent
ANTHROPIC_API_KEY=                # requis seulement si un modèle « claude-… » est utilisé
# Modèle par défaut ; surchargeable par client (config.agent.model dans le JSON du client).
# Le fournisseur est choisi d'après le nom : « claude-… » -> Anthropic ; sinon -> LLM_API_KEY / LLM_BASE_URL.
#   Tests gratuits (NVIDIA NIM, clé gratuite sur build.nvidia.com) : nvidia/nemotron-3-super-120b-a12b
#                                                                 ou meta/llama-3.3-70b-instruct
#   Démo financeurs : claude-sonnet-5-5
AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_API_KEY=                      # clé « nvapi-… » de build.nvidia.com (ou de tout fournisseur compatible OpenAI)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
GRAPH_API_VERSION=v23.0           # à vérifier dans le changelog Meta
SEND_MODE=console                 # "console" : affiche les réponses ; "messenger" : envoie vraiment

# Transcription des messages vocaux (Groq Whisper, compatible OpenAI). Vide = vocaux non transcrits.
# Sert aussi de repli pour l'agent si LLM_API_KEY est vide.
GROQ_API_KEY=
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
TRANSCRIPTION_LANGUAGE=fr         # vide = détection automatique

# Lecture des images envoyées par les clients (modèle de vision). Vide = images non lues (l'agent demande d'écrire).
# « claude-… » -> Anthropic (ANTHROPIC_API_KEY) ; sinon API compatible OpenAI : VISION_API_KEY / VISION_BASE_URL,
# à défaut LLM_API_KEY / LLM_BASE_URL, puis GROQ_API_KEY. Vérifier le modèle avec : python -m scripts.vision_diag photo.jpg
#   NVIDIA NIM : meta/llama-3.2-11b-vision-instruct (ou une autre variante « vision » disponible pour votre compte)
#   Démo financeurs : claude-sonnet-5-5
VISION_MODEL=
VISION_API_KEY=
VISION_BASE_URL=

# Paiement FedaPay (bac à sable en développement) : https://docs.fedapay.com
FEDAPAY_SECRET_KEY=               # clé API secrète du bac à sable (tableau de bord FedaPay)
FEDAPAY_ENVIRONMENT=sandbox       # "sandbox" ou "live"
FEDAPAY_WEBHOOK_SECRET=           # secret du endpoint webhook (Webhooks > votre endpoint > afficher la clé)
FEDAPAY_CALLBACK_URL=             # optionnel : page où FedaPay renvoie le client après paiement
FEDAPAY_CUSTOMER_EMAIL=           # OBLIGATOIRE : e-mail de l'entreprise (reçoit la facture FedaPay)

# Console d'entreprise : http(s)://<hôte>/console  (désactivée tant que CONSOLE_PASSWORD est vide)
CONSOLE_PASSWORD=                 # mot de passe unique (démo) : choisir une phrase longue
CONSOLE_TENANT_ID=                # UUID du client géré (SELECT id FROM tenants WHERE slug = 'maison-kora')
CONSOLE_UTC_OFFSET_HOURS=1        # affichage des heures (Bénin : UTC+1)

# Publications Facebook : fréquence de vérification des publications programmées (secondes)
SOCIAL_SCHEDULER_SECONDS=10

# WhatsApp NON officiel via Evolution API (prototype, gratuit) : docker compose -f docker-compose.evolution.yml up -d
# Risque : contraire aux conditions de WhatsApp -> utiliser un numéro dédié au test, jamais votre numéro principal.
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=                # chaîne aléatoire longue (python -c "import secrets; print(secrets.token_urlsafe(32))")
EVOLUTION_WEBHOOK_SECRET=         # autre chaîne aléatoire : Evolution la renvoie dans X-Webhook-Secret
